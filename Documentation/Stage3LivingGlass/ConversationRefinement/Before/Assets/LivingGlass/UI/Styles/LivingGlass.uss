/* Unity 6000.4 baseline: no CSS grid/gap, backdrop filters, box shadows or perspective. */
.lg-app {
    --lg-floor: #0c1117; --lg-text: #f3f0e8; --lg-secondary: #c2cbd5;
    --lg-reading: #17212c; --lg-glass: rgba(31,43,55,0.97); --lg-edge: #526475;
    --lg-type-display: 72px; --lg-type-gallery: 56px; --lg-type-panel: 34px;
    --lg-type-body: 25px; --lg-type-small: 19px; --lg-type-action: 22px;
    flex-grow: 1; width: 100%; height: 100%; overflow: hidden;
    background-color: var(--lg-floor); color: var(--lg-text); font-size: 24px;
    -unity-font-style: normal; letter-spacing: 0;
}
.lg-content { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lg-atmosphere { position: absolute; left: 20%; top: 14%; width: 68%; height: 68%; border-radius: 400px; }
.lg-header { position: absolute; left: 5%; right: 5%; top: 34px; flex-direction: row; justify-content: space-between; align-items: center; }
.lg-wordmark { font-size: 22px; letter-spacing: 1.5px; margin-bottom: 6px; }
.lg-eyebrow { font-size: 18px; color: var(--lg-secondary); letter-spacing: 1px; margin-top: 0; margin-bottom: 18px; white-space: normal; }
.lg-display { font-size: var(--lg-type-display); white-space: normal; margin-top: 0; margin-bottom: 22px; -unity-font-style: normal; flex-shrink: 0; }
.lg-body { font-size: var(--lg-type-body); color: var(--lg-secondary); white-space: normal; margin-top: 0; margin-bottom: 24px; flex-shrink: 0; }
.lg-small { font-size: var(--lg-type-small); color: var(--lg-secondary); white-space: normal; margin-top: 8px; margin-bottom: 12px; flex-shrink: 0; }
.lg-action {
    min-height: 60px; padding: 12px 24px; margin: 6px 12px 6px 0;
    background-color: #283747; color: var(--lg-text); border-width: 1px; border-color: #536473; border-radius: 14px;
    font-size: var(--lg-type-action); white-space: normal; -unity-font-style: normal; -unity-text-align: middle-center;
    transition-property: background-color, border-color; transition-duration: 0.12s;
}
.lg-action:hover { background-color: #344555; border-color: #a8bac6; }
.lg-action:active { background-color: #182532; }
.lg-action:focus, .lg-presence:focus, .lg-assistant-choice:focus { border-width: 3px; border-color: #f3f0e8; }
.lg-action:disabled { background-color: #17202a; color: #9caab8; border-color: #35414c; }
.lg-primary { background-color: #e9f0ef; color: #10202a; border-color: #e9f0ef; }
.lg-primary:hover { color: #f3f0e8; background-color: #3c5967; }
.lg-quiet { background-color: rgba(18,29,41,0.9); }
.lg-actions { flex-direction: row; flex-wrap: wrap; align-items: center; }
.lg-standard { position: absolute; left: 7%; right: 5%; top: 16%; bottom: 20%; flex-direction: row; align-items: center; }
.lg-copy { width: 48%; padding-right: 64px; flex-shrink: 0; }
.lg-standard-art { width: 52%; height: 100%; border-radius: 4px; }
.lg-consent { min-height: 60px; justify-content: center; color: #f3f0e8; font-size: 23px; margin-top: 18px; margin-bottom: 12px; white-space: normal; }
.lg-consent .unity-toggle__input { width: 28px; height: 28px; margin-right: 14px; }
.lg-consent .unity-toggle__text { color: #f3f0e8; white-space: normal; height: auto; min-height: 36px; flex-shrink: 0; -unity-text-align: middle-left; }
.lg-consent .unity-toggle__checkmark { width: 28px; height: 28px; margin-right: 14px; background-color: #101b26; border-width: 1px; border-color: #718493; border-radius: 6px; }
.lg-dock { position: absolute; align-self: center; bottom: 28px; flex-direction: row; padding: 9px; border-width: 1px; border-color: #435362; border-top-color: #72838f; border-radius: 28px; background-color: var(--lg-glass); }
.lg-dock-action { background-color: rgba(0,0,0,0); border-color: rgba(0,0,0,0); border-radius: 19px; min-width: 120px; margin: 0 3px; }
.lg-protected .lg-dock { left: 4%; right: 4%; bottom: 12px; justify-content: space-between; border-radius: 0; border-left-width: 0; border-right-width: 0; border-bottom-width: 0; background-color: #0c1117; }
.lg-protected .lg-header { display: none; }
.lg-protected .lg-camera { display: none; }
.lg-camera { position: absolute; left: 5%; bottom: 28px; width: 242px; max-height: 180px; }
.lg-camera-status { font-size: 18px; color: var(--lg-secondary); white-space: normal; }
.lg-preview { height: 110px; width: 196px; background-color: #17212c; border-width: 1px; border-color: #526475; border-radius: 10px; margin-bottom: 8px; }
.lg-gallery-title { position: absolute; left: 5%; right: 5%; top: 12.5%; flex-direction: row; justify-content: space-between; }
.lg-gallery-title-copy { width: 62%; }
.lg-gallery-title .lg-display { font-size: var(--lg-type-gallery); }
.lg-gallery-guidance { font-size: 23px; white-space: normal; width: 31%; color: var(--lg-secondary); margin-top: 44px; }
.lg-gallery-arc { position: absolute; left: 5%; right: 5%; top: 31.48%; height: 464px; flex-direction: row; }
.lg-presence {
    flex-grow: 1; flex-basis: 0; min-width: 0; height: 464px; flex-shrink: 1;
    margin: 0 16px; padding: 0; background-color: rgba(0,0,0,0); border-width: 3px; border-color: rgba(0,0,0,0); border-radius: 7px; justify-content: flex-start;
}
.lg-first-presence { margin-left: 0; }
.lg-last-presence { margin-right: 0; }
.lg-presence:hover { background-color: rgba(0,0,0,0); }
.lg-presence:active { background-color: rgba(0,0,0,0); }
.lg-aperture { width: 100%; overflow: hidden; border-radius: 4px; flex-shrink: 0; }
.lg-far .lg-aperture { height: 340px; margin-top: 38px; }
.lg-mid .lg-aperture { height: 370px; margin-top: 16px; }
.lg-near .lg-aperture { height: 400px; margin-top: 0; }
.lg-portrait { width: 100%; height: 100%; }
.lg-rim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; border-top-width: 2px; border-bottom-width: 2px; border-color: rgba(0,0,0,0); }
.lg-performer-name { font-size: 22px; white-space: normal; margin-top: 14px; color: var(--lg-text); -unity-text-align: upper-left; }
.lg-acquiring .lg-performer-name { color: #f3d8a3; }
.lg-targeted .lg-performer-name { color: var(--lg-text); }
.lg-identification { position: absolute; align-self: center; bottom: 14.1%; width: 820px; min-height: 110px; padding: 18px 25px; flex-direction: row; align-items: center; background-color: var(--lg-glass); border-width: 1px; border-color: #435362; border-top-color: #72838f; border-radius: 24px; }
.lg-identity-index { width: 45px; font-size: 20px; }
.lg-identity-copy { flex-grow: 1; flex-basis: 0; }
.lg-identity-title { font-size: 26px; white-space: normal; }
.lg-identification .lg-small { font-size: 17px; margin-bottom: 0; }
.lg-identification .lg-action { margin-right: 0; margin-left: 20px; min-width: 160px; }
.lg-chapter { position: absolute; left: 4%; right: 4%; top: 13%; bottom: 17%; }
.lg-chapter-art { position: absolute; left: 44.5%; right: 0; top: 0; bottom: 0; border-radius: 4px; }
.lg-chapter-copy { width: 48%; max-height: 100%; padding: 40px; margin-top: 40px; }
.lg-chapter-copy .lg-display { font-size: 60px; }
.lg-reading-tint { background-color: rgba(15,23,33,0.97); border-radius: 24px; }
.lg-protected .lg-chapter { left: 0; right: 0; top: 0; bottom: 100px; }
.lg-protected .lg-chapter-art { left: 0; opacity: 0.7; }
.lg-protected .lg-chapter-copy { margin-left: 6%; margin-top: 12%; }
.lg-video-surface { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: #080b10; background-size: contain; background-position: center; background-repeat: no-repeat; }
.lg-portrait-status { align-self: center; margin-top: 34px; padding: 18px 24px; background-color: #17212c; border-radius: 14px; font-size: 22px; white-space: normal; }
.lg-reading { position: absolute; left: 18%; right: 18%; top: 16%; bottom: 18%; padding: 32px 44px; background-color: var(--lg-reading); border-width: 1px; border-color: #526475; border-radius: 26px; }
.lg-reading-body { flex-grow: 1; }
.lg-panel-title { font-size: var(--lg-type-panel); white-space: normal; flex-grow: 1; flex-basis: 0; -unity-font-style: normal; }
.lg-subtitle { font-size: 25px; white-space: normal; margin-top: 12px; margin-bottom: 12px; }
.lg-reading > .lg-panel-title { height: 58px; min-height: 58px; flex-grow: 0; flex-basis: 58px; flex-shrink: 0; margin-bottom: 24px; }
.lg-hidden { display: none; }
.lg-overlay-plane { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(3,7,13,0.58); align-items: flex-end; justify-content: center; padding: 100px 4% 120px; }
.lg-window { width: 760px; max-width: 90%; max-height: 100%; background-color: var(--lg-glass); border-width: 1px; border-color: #526475; border-top-color: #7c8b98; border-radius: 30px; padding: 28px 34px; }
.lg-window-titlebar { flex-direction: row; align-items: center; margin-bottom: 18px; flex-shrink: 0; }
.lg-window-tool { padding: 8px 12px; font-size: 17px; min-height: 48px; margin-left: 10px; margin-right: 0; }
.lg-window-body { flex-shrink: 1; min-height: 120px; }
/* Keep the native Scroller/Slider behavior and visible controls; theme their actual child nodes. */
.lg-app .unity-scroll-view { border-width: 1px; border-color: rgba(0,0,0,0); border-radius: 12px; }
.lg-app .unity-scroll-view:focus { border-color: #f3f0e8; }
.lg-app .unity-scroller--vertical { width: 24px; min-width: 24px; margin-left: 12px; background-color: #101b26; border-radius: 12px; }
.lg-app .unity-scroller--horizontal { height: 24px; min-height: 24px; background-color: #101b26; border-radius: 12px; }
.lg-app .unity-scroller__slider { margin: 0; padding: 0; background-color: rgba(0,0,0,0); }
.lg-app .unity-scroller .unity-base-slider__tracker { background-color: #182532; border-width: 0; border-radius: 6px; }
.lg-app .unity-scroller .unity-base-slider__dragger { background-color: #8496a5; border-width: 1px; border-color: #a8bac6; border-radius: 6px; min-height: 32px; }
.lg-app .unity-scroller .unity-base-slider__dragger:hover { background-color: #b0c1cc; }
.lg-app .unity-scroller .unity-base-slider__dragger-border { background-color: rgba(0,0,0,0); border-width: 0; }
.lg-app .unity-scroller__slider:focus .unity-base-slider__dragger { border-width: 2px; border-color: #f3f0e8; }
.lg-app .unity-scroller .unity-repeat-button { width: 24px; height: 24px; min-height: 24px; margin: 0; padding: 0; background-image: none; background-color: #283747; border-width: 1px; border-color: #526475; border-radius: 7px; color: #f3f0e8; font-size: 14px; -unity-text-align: middle-center; }
.lg-app .unity-scroller .unity-repeat-button:hover { background-color: #344555; }
.lg-app .unity-scroller .unity-repeat-button:active { background-color: #182532; }
.lg-app .unity-scroller .unity-repeat-button:focus { border-width: 2px; border-color: #f3f0e8; }
.lg-app .unity-scroller:disabled { opacity: 0.45; }
.lg-setting-row { flex-direction: row; align-items: center; padding: 15px 0; border-bottom-width: 1px; border-bottom-color: #354351; }
.lg-setting-copy { flex-grow: 1; flex-basis: 0; margin-right: 24px; }
.lg-setting-row .lg-subtitle { margin: 0 0 4px; font-size: 23px; }
.lg-setting-row .lg-action { font-size: 18px; min-width: 125px; }
.lg-chooser { flex-direction: row; flex-wrap: wrap; margin-top: 20px; }
.lg-assistant-choice { width: 46%; min-height: 122px; margin: 10px 2%; padding: 12px; flex-direction: row; align-items: center; background-color: #1e2a37; border-width: 2px; border-color: #3f5262; border-radius: 14px; }
.lg-assistant-thumb { width: 60px; height: 85px; margin-right: 12px; }
.lg-choice-name { flex-grow: 1; flex-basis: 0; white-space: normal; font-size: 18px; }
.lg-suggestions { flex-direction: row; flex-wrap: wrap; }
.lg-suggestion { min-height: 48px; font-size: 18px; padding: 10px 14px; }
.lg-conversation { height: 230px; min-height: 120px; background-color: #101b26; border-radius: 14px; padding: 16px; margin-top: 10px; }
.lg-empty { font-size: 20px; white-space: normal; color: #9caab8; margin-bottom: 14px; }
.lg-chat-status { font-size: 20px; white-space: normal; color: #f3d8a3; }
.lg-chat-input { margin: 18px 0 8px; font-size: 21px; flex-direction: column; }
.lg-chat-input .unity-text-field__input { min-height: 76px; padding: 12px; white-space: normal; background-color: #0f1823; color: var(--lg-text); border-width: 1px; border-color: #718493; border-radius: 12px; }
.lg-chat-input .unity-text-field__label { margin-bottom: 10px; }
.lg-postvideo-copy { width: 60%; margin-top: 0; padding: 22px 32px; }
.lg-postvideo-copy .lg-display { font-size: 36px; margin-bottom: 4px; }
.lg-postvideo-copy .lg-body, .lg-postvideo-copy .lg-eyebrow { margin-bottom: 4px; }
.lg-postvideo-copy .lg-conversation { height: 150px; }
.lg-postvideo-copy .lg-small { font-size: 17px; }
.ac-assistant-chat-message { white-space: normal; font-size: 21px; color: var(--lg-text); margin-bottom: 14px; }
.ac-assistant-chat-user-message { color: #c2cbd5; padding: 12px; background-color: #273b4b; border-radius: 12px; }
.ac-assistant-chat-hidden { display: none; }
.ac-assistant-chat-heading { font-size: 25px; }
.ac-assistant-chat-paragraph-gap { height: 12px; }
.ac-assistant-chat-code-line { white-space: normal; font-size: 19px; }
.lg-help-row { flex-direction: row; align-items: center; min-height: 100px; }
.lg-help-symbol { width: 92px; height: 92px; margin-right: 20px; }
.lg-gesture-stage { width: 50%; height: 100%; align-items: center; justify-content: center; border-radius: 40px; background-color: rgba(27,42,57,0.8); }
.lg-gesture-symbol { width: 420px; height: 420px; }
.lg-progress { flex-direction: row; margin-top: 12px; margin-bottom: 24px; }
.lg-step { width: 40px; height: 4px; margin-right: 10px; background-color: #354351; border-radius: 2px; }
.lg-current { background-color: #dbe7e7; }
.lg-announcement { position: absolute; right: 5%; bottom: 125px; max-width: 470px; white-space: normal; font-size: 18px; color: #f3d8a3; }
.lg-resume { position: absolute; right: 4%; bottom: 118px; }
.lg-bridge { position: absolute; }
.lg-zh .lg-display { font-size: 64px; }
.lg-zh .lg-eyebrow { letter-spacing: 0; }
.lg-zh .lg-gallery-title .lg-display { font-size: 54px; }
.lg-compact .lg-display { font-size: 54px; }
.lg-compact .lg-copy { padding-right: 32px; }
.lg-compact .lg-gallery-title .lg-display { font-size: 48px; }
.lg-compact .lg-gallery-guidance { font-size: 20px; }
.lg-compact .lg-gallery-arc { height: 43%; }
.lg-compact .lg-presence { height: 100%; margin-left: 10px; margin-right: 10px; }
.lg-compact .lg-far .lg-aperture { height: 73%; margin-top: 8%; }
.lg-compact .lg-mid .lg-aperture { height: 80%; margin-top: 4%; }
.lg-compact .lg-near .lg-aperture { height: 86%; }
.lg-compact .lg-performer-name { font-size: 18px; }
.lg-compact .lg-camera { width: 185px; }
.lg-compact .lg-dock-action { min-width: 98px; font-size: 19px; padding-left: 16px; padding-right: 16px; }
.lg-compact .lg-reading { left: 10%; right: 10%; }
.lg-opaque .lg-atmosphere { display: none; }
.lg-opaque .lg-window, .lg-opaque .lg-dock, .lg-opaque .lg-identification { background-color: #243343; }
.lg-reduced .lg-action { transition-duration: 0s; }
