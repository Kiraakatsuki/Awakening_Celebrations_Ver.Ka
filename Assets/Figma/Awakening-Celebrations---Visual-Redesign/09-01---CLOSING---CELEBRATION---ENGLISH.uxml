    <ui:VisualElement style="width: 1920px; height: 900px; border-radius: 24px; background-color: #0E0E0E;">
        <ui:VisualElement style="width: 1920px; height: 900px; border-radius: 24px; background-color: #171717; position: absolute; left: 0px; top: 0px;" />
        <ui:VisualElement style="width: 520px; height: 520px; border-radius: 260px; background-color: rgba(49, 215, 242, 0.32); position: absolute; left: 700px; top: 110px;" />
        <ui:VisualElement style="width: 400px; height: 400px; border-radius: 200px; background-color: rgba(243, 185, 95, 0.32); position: absolute; left: 1250px; top: 230px;" />
        <ui:Label text="AWAKENING COMPLETE" class="unity-label" style="width: 700px; color: #31D7F2; -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 16px; -unity-font-style: bold; white-space: normal; position: absolute; left: 72px; top: 72px;" />
        <ui:Label text="The world returns to stillness." class="unity-label" style="width: 1000px; color: #EFEAE0; -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 42px; -unity-font-style: bold; white-space: normal; position: absolute; left: 72px; top: 122px;" />
        <ui:Label text="A short celebration resolves the experience before the souvenir is offered." class="unity-label" style="width: 900px; color: #AEABA4; -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 16px; white-space: normal; position: absolute; left: 72px; top: 180px;" />
        <ui:VisualElement style="width: 1776px; height: 360px; border-radius: 32px; border-width: 1px; border-color: rgba(49, 215, 242, 0.30); background-color: rgba(31, 33, 36, 0.78); position: absolute; left: 72px; top: 290px;">
            <ui:Label text="Thank you for awakening the story." class="unity-label" style="width: 900px; color: #EFEAE0; -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 30px; -unity-font-style: bold; white-space: normal; position: absolute; left: 48px; top: 54px;" />
            <ui:Label text="The performer returns to the shared world. Your digital souvenir is ready when you are." class="unity-label" style="width: 1100px; color: #AEABA4; -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 15px; white-space: normal; position: absolute; left: 48px; top: 100px;" />
            <ui:VisualElement style="width: 220px; height: 54px; border-radius: 27px; border-width: 1px; border-color: rgba(243, 185, 95, 0.30); background-color: rgba(58, 44, 23, 0.95); position: absolute; left: 48px; top: 220px;" />
            <ui:Label text="Get my souvenir" class="unity-label" style="width: 184px; color: #EFEAE0; -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 15px; -unity-font-style: bold; white-space: normal; position: absolute; left: 66px; top: 235px;" />
            <ui:VisualElement style="width: 250px; height: 54px; border-radius: 27px; border-width: 1px; border-color: rgba(49, 215, 242, 0.30); background-color: rgba(12, 52, 58, 0.95); position: absolute; left: 290px; top: 220px;" />
            <ui:Label text="Return to experience" class="unity-label" style="width: 214px; color: #EFEAE0; -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 15px; -unity-font-style: bold; white-space: normal; position: absolute; left: 308px; top: 235px;" />
