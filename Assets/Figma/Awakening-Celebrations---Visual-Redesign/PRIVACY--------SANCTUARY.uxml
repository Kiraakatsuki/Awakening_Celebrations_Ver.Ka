        <ui:Label text="01  手勢追蹤" class="unity-label" style="width: 780px; color: rgb(242, 237, 222); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 20px; -unity-font-style: bold; white-space: normal; position: absolute; left: 116px; top: 394px;"/>
        <ui:Label text="使用攝影機進行手勢追蹤，以解讀您與裝置之間的互動。" class="unity-label" style="width: 950px; color: rgb(242, 237, 222); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 16px; white-space: normal; position: absolute; left: 116px; top: 434px;"/>
        <ui:Label text="" class="unity-label" style="white-space: normal; position: absolute; left: 116px; top: 462px;"/>
        <ui:VisualElement style="width: 1000px; height: 1px; background-color: rgba(102, 87, 61, 0.45); position: absolute; left: 116px; top: 504px;"/>
        <ui:Label text="02  資料處理" class="unity-label" style="width: 780px; color: rgb(242, 237, 222); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 20px; -unity-font-style: bold; white-space: normal; position: absolute; left: 116px; top: 538px;"/>
        <ui:Label text="場地方隱私政策與最終 Unity 實作將說明資料如何處理、儲存、保留或刪除。" class="unity-label" style="width: 950px; color: rgb(242, 237, 222); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 16px; white-space: normal; position: absolute; left: 116px; top: 578px;"/>
        <ui:Label text="" class="unity-label" style="white-space: normal; position: absolute; left: 116px; top: 606px;"/>
        <ui:VisualElement style="width: 1000px; height: 1px; background-color: rgba(102, 87, 61, 0.45); position: absolute; left: 116px; top: 648px;"/>
        <ui:Label text="03  您的選擇" class="unity-label" style="width: 780px; color: rgb(242, 237, 222); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 20px; -unity-font-style: bold; white-space: normal; position: absolute; left: 116px; top: 682px;"/>
        <ui:Label text="您可以拒絕並返回入口。繼續進入手勢互動前必須同意。" class="unity-label" style="width: 950px; color: rgb(242, 237, 222); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 16px; white-space: normal; position: absolute; left: 116px; top: 722px;"/>
