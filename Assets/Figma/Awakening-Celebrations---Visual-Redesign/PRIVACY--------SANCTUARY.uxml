        <ui:Label text="隱私與同意" class="unity-label" style="width: 900px; color: rgb(242, 237, 222); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 44px; -unity-font-style: bold; white-space: normal; position: absolute; left: 72px; top: 106px;"/>
        <ui:Label text="" class="unity-label" style="white-space: normal; position: absolute; left: 72px; top: 164px;"/>
        <ui:Label text="啟用手勢互動前，請閱讀以下說明。" class="unity-label" style="width: 820px; color: rgb(242, 237, 222); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 18px; white-space: normal; position: absolute; left: 72px; top: 216px;"/>
        <ui:VisualElement style="width: 1120px; height: 570px; border-radius: 34px; border-width: 1px; border-color: rgba(243, 185, 95, 0.25); background-color: rgba(18, 17, 13, 0.9); position: absolute; left: 72px; top: 300px;"/>
