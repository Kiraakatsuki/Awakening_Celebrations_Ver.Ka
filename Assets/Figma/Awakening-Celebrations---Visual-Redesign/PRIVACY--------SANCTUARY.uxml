        <ui:Label text="準備繼續嗎？" class="unity-label" style="width: 500px; color: rgb(243, 185, 95); -unity-font-definition: url(&quot;project://database/Packages/com.unity.dt.app-ui/PackageResources/Fonts/Inter-Regular.ttf?fileID=12800000&amp;guid=f129b03ed61794ba68a0ed3044e56031&amp;type=3#Inter-Regular&quot;); font-size: 13px; -unity-font-style: bold; white-space: normal; position: absolute; left: 1304px; top: 346px;"/>
